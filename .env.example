# =============================================================================
# Landora Real Estate & Land-Selling Marketplace
# Environment Variables Example Configuration
# =============================================================================

# Application Configuration
NEXT_PUBLIC_APP_NAME="Landora"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# PostgreSQL Database (Prisma ORM)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=[schema]
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/landora?schema=public"

# NextAuth / Auth.js Secret Key
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your_nextauth_secret_key_32_characters_minimum"
NEXTAUTH_URL="http://localhost:3000"

# Cloudinary Cloud Image Storage (Property Photographs)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="landora-demo"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Razorpay Indian Payment Gateway (Paid Listing Packages)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

# Email Notification Service (SMTP / Transactional Email)
EMAIL_SERVER_HOST="smtp.mailtrap.io"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="your_smtp_username"
EMAIL_SERVER_PASSWORD="your_smtp_password"
EMAIL_FROM="Landora Marketplace <noreply@landora.in>"

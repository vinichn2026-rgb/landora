# =============================================================================
# Landora Real Estate & Land-Selling Marketplace
# Environment Variables Example Configuration for Production & Staging
# =============================================================================

# 1. CORE APPLICATION CONFIGURATION
NEXT_PUBLIC_APP_NAME="Landora"
NEXT_PUBLIC_APP_URL="https://landora.in"
NODE_ENV="production"

# 2. MANAGED POSTGRESQL DATABASE (PRISMA ORM)
# Compatible with Neon, Supabase, Vercel Postgres, AWS RDS
DATABASE_URL="postgresql://postgres:your_password@ep-your-db.us-east-1.aws.neon.tech/landora?sslmode=require"

# 3. AUTHENTICATION & JWT SESSION SECURITY
# Mandatory 32+ character secret for HMAC SHA256 session token signing
# Generate with: openssl rand -base64 32
JWT_SECRET="your_super_secret_jwt_key_at_least_32_characters_long"
NEXTAUTH_SECRET="your_nextauth_secret_key_32_characters_minimum"
NEXTAUTH_URL="https://landora.in"

# 4. CLOUDINARY CLOUD IMAGE STORAGE (PROPERTY PHOTOGRAPHS)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# 5. RAZORPAY INDIAN PAYMENT GATEWAY
# Get test & live keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_live_your_production_key_id"
RAZORPAY_KEY_SECRET="your_production_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_configured_webhook_secret_for_authenticity"

# 6. TRANSACTIONAL EMAIL NOTIFICATION SERVICE
# Option A: Resend API (Recommended)
RESEND_API_KEY="re_your_resend_api_key_here"
EMAIL_FROM="Landora Marketplace <notifications@landora.in>"

# Option B: Standard SMTP (AWS SES, Mailgun, Brevo, SendGrid)
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT="587"
SMTP_USER="apikey"
SMTP_PASS="your_smtp_api_key"

# 7. OPTIONAL SMS & WHATSAPP NOTIFICATIONS (TWILIO)
TWILIO_ACCOUNT_SID="AC_your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+1234567890"
TWILIO_WHATSAPP_NUMBER="+14155238886"

# 8. SENTRY ERROR MONITORING (OPTIONAL)
NEXT_PUBLIC_SENTRY_DSN=""

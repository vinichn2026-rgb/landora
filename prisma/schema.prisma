// Landora Real Estate & Land-Selling Marketplace
// Prisma Schema Definition for PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------
enum UserRole {
  BUYER
  SELLER
  AGENT
  BUILDER
  ADMIN
}

enum SellerType {
  OWNER
  AGENT
  BUILDER
}

enum ListingType {
  SALE
  RENT
  LEASE
}

enum PropertyCategoryType {
  RESIDENTIAL_PLOT
  AGRICULTURAL_LAND
  HOUSE
  APARTMENT
  VILLA
  COMMERCIAL_PLOT
  COMMERCIAL_BUILDING
  INDUSTRIAL
}

enum PropertyStatus {
  ACTIVE
  PENDING
  REJECTED
  EXPIRED
  SOLD
}

enum VerificationLevel {
  UNREVIEWED
  CONTACT_VERIFIED
  INFO_REVIEWED
  DOCS_SUBMITTED
  INDEPENDENTLY_VERIFIED
}

enum FurnishingStatus {
  Unfurnished
  Semi_Furnished @map("Semi-Furnished")
  Fully_Furnished @map("Fully-Furnished")
}

enum EnquiryStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  CLOSED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum ReportStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  DISMISSED
}

// -----------------------------------------------------------------------------
// USER MANAGEMENT & PROFILE
// -----------------------------------------------------------------------------
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  phoneNumber   String?   @unique
  passwordHash  String?
  role          UserRole  @default(BUYER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile           UserProfile?
  agencyMemberships AgencyMember[]
  properties        Property[]
  savedProperties   SavedProperty[]
  enquiriesSent     Enquiry[]        @relation("BuyerEnquiries")
  enquiriesReceived Enquiry[]        @relation("SellerEnquiries")
  payments          Payment[]
  reportsSubmitted  PropertyReport[]
  notifications     Notification[]
  auditLogs         AuditLog[]

  @@index([role])
}

model UserProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarUrl         String?
  bio               String?
  companyName       String?
  taxId             String? // GST or PAN
  reraRegistration  String?
  address           String?
  city              String?
  state             String?  @default("Tamil Nadu")
  pinCode           String?
  isPhoneVerified   Boolean  @default(false)
  isEmailVerified   Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// AGENCY & BROKERAGE
// -----------------------------------------------------------------------------
model Agency {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  logoUrl     String?
  reraNumber  String?
  phone       String?
  email       String?
  website     String?
  address     String?
  city        String
  state       String         @default("Tamil Nadu")
  members     AgencyMember[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([city])
}

model AgencyMember {
  id        String   @id @default(cuid())
  agencyId  String
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("AGENT") // AGENT, PRINCIPAL, BROKER
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agencyId, userId])
}

// -----------------------------------------------------------------------------
// PROPERTY LISTINGS
// -----------------------------------------------------------------------------
model Property {
  id                  String               @id @default(cuid())
  slug                String               @unique
  title               String
  description         String               @db.Text
  listingType         ListingType          @default(SALE)
  propertyType        PropertyCategoryType
  price               Decimal              @db.Decimal(14, 2)
  pricePerUnit        String?
  area                Decimal              @db.Decimal(12, 2)
  areaUnit            String               @default("sqft") // sqft, cent, acre, sqyd
  builtUpArea         Decimal?             @db.Decimal(12, 2)
  bedrooms            Int?
  bathrooms           Int?
  furnishing          FurnishingStatus?
  facing              String?
  roadWidthFt         Decimal?             @db.Decimal(6, 2)
  plotDimensions      String?
  surveyNumber        String?
  landClassification  String?
  documentStatus      String?
  approvalStatus      String               @default("Seller Declared")
  address             String
  locality            String
  city                String
  state               String               @default("Tamil Nadu")
  pinCode             String
  latitude            Decimal?             @db.Decimal(10, 7)
  longitude           Decimal?             @db.Decimal(10, 7)
  status              PropertyStatus       @default(ACTIVE)
  verificationStatus  VerificationLevel    @default(UNREVIEWED)
  isFeatured          Boolean              @default(false)
  viewsCount          Int                  @default(0)
  ownerId             String
  owner               User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  sellerType          SellerType           @default(OWNER)
  packageId           String?
  package             ListingPackage?      @relation(fields: [packageId], references: [id], onDelete: SetNull)
  publishedAt         DateTime             @default(now())
  expiresAt           DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  images              PropertyImage[]
  amenities           PropertyAmenity[]
  savedBy             SavedProperty[]
  enquiries           Enquiry[]
  reports             PropertyReport[]
  verificationRecords VerificationRecord[]

  @@index([city])
  @@index([locality])
  @@index([propertyType])
  @@index([listingType])
  @@index([price])
  @@index([area])
  @@index([status])
  @@index([isFeatured])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// PROPERTY IMAGES & STORAGE REFERENCES
// -----------------------------------------------------------------------------
model PropertyImage {
  id              String   @id @default(cuid())
  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url             String
  caption         String?
  isPrimary       Boolean  @default(false)
  order           Int      @default(0)
  storageProvider String   @default("cloudinary") // e.g., cloudinary, s3, cdn
  storageKey      String?
  createdAt       DateTime @default(now())

  @@index([propertyId])
  @@index([isPrimary])
}

// -----------------------------------------------------------------------------
// PROPERTY AMENITIES
// -----------------------------------------------------------------------------
model PropertyAmenity {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name       String   // e.g. "30ft Tar Road", "Underground Drainage"
  category   String?  // e.g. "INFRASTRUCTURE", "SECURITY"
  createdAt  DateTime @default(now())

  @@unique([propertyId, name])
  @@index([propertyId])
}

// -----------------------------------------------------------------------------
// USER ENGAGEMENT & SAVED PROPERTIES
// -----------------------------------------------------------------------------
model SavedProperty {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
}

// -----------------------------------------------------------------------------
// BUYER ENQUIRIES
// -----------------------------------------------------------------------------
model Enquiry {
  id          String        @id @default(cuid())
  propertyId  String
  property    Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  buyerId     String?
  buyer       User?         @relation("BuyerEnquiries", fields: [buyerId], references: [id], onDelete: SetNull)
  sellerId    String
  seller      User          @relation("SellerEnquiries", fields: [sellerId], references: [id], onDelete: Cascade)
  buyerName   String
  buyerEmail  String
  buyerPhone  String
  message     String        @db.Text
  status      EnquiryStatus @default(NEW)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([propertyId])
  @@index([sellerId])
  @@index([createdAt])
  @@index([status])
}

// -----------------------------------------------------------------------------
// LISTING PACKAGES & MONETIZATION
// -----------------------------------------------------------------------------
model ListingPackage {
  id           String     @id @default(cuid())
  name         String
  slug         String     @unique
  price        Decimal    @db.Decimal(10, 2)
  durationDays Int
  listingLimit Int
  isFeatured   Boolean    @default(false)
  description  String?
  features     String[]
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  properties   Property[]
  payments     Payment[]

  @@index([isActive])
}

// -----------------------------------------------------------------------------
// PAYMENTS & RAZORPAY BILLING
// -----------------------------------------------------------------------------
model Payment {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId        String?
  package          ListingPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  amount           Decimal         @db.Decimal(10, 2)
  currency         String          @default("INR")
  gateway          String          @default("RAZORPAY")
  gatewayPaymentId String?
  gatewayOrderId   String?
  status           PaymentStatus   @default(PENDING)
  receiptUrl       String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([userId])
  @@index([status])
  @@index([gatewayOrderId])
}

// -----------------------------------------------------------------------------
// COMPLIANCE & REPORTING
// -----------------------------------------------------------------------------
model PropertyReport {
  id              String       @id @default(cuid())
  propertyId      String
  property        Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  reporterName    String
  reporterEmail   String?
  reason          String
  details         String       @db.Text
  status          ReportStatus @default(OPEN)
  resolutionNotes String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([propertyId])
  @@index([status])
}

// -----------------------------------------------------------------------------
// VERIFICATION RECORDS
// -----------------------------------------------------------------------------
model VerificationRecord {
  id              String            @id @default(cuid())
  propertyId      String
  property        Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  verifierId      String?
  level           VerificationLevel
  notes           String?           @db.Text
  documentChecked String? // e.g. "TNREGINET Patta & 30-Year EC"
  isApproved      Boolean           @default(true)
  createdAt       DateTime          @default(now())

  @@index([propertyId])
}

// -----------------------------------------------------------------------------
// NOTIFICATIONS
// -----------------------------------------------------------------------------
model Notification {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  message    String   @db.Text
  type       String   @default("ENQUIRY") // ENQUIRY, LISTING_APPROVED, PAYMENT, ALERT
  entityType String? // PROPERTY, ENQUIRY
  entityId   String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

// -----------------------------------------------------------------------------
// AUDIT LOGS
// -----------------------------------------------------------------------------
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  details    String?  @db.Text
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}
